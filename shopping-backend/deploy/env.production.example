# Copy to .env for production-ish runs. Local development needs none of this: the defaults in
# shopping_backend/core/config.py already work with plain SQLite.

APP_ENV=prod
LOG_LEVEL=INFO

# --- data source: MySQL instead of the local SQLite file -------------------
DATABASE_URL=mysql+pymysql://shopping:CHANGE_ME@mysql:3306/shopping?charset=utf8mb4
# requires: uv sync --extra mysql
SEED_ON_STARTUP=false

# --- checkpointer ----------------------------------------------------------
# single replica -> sqlite on a volume is fine; multiple replicas -> postgres
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=/data/agent-checkpoints.db
# CHECKPOINT_BACKEND=postgres
# POSTGRES_CHECKPOINT_URL=postgresql://checkpoints:CHANGE_ME@postgres:5432/checkpoints

# --- agent <-> business ----------------------------------------------------
BACKEND_DRIVER=http
BUSINESS_API_BASE_URL=http://business:8001
BUSINESS_API_TOKEN=CHANGE_ME_long_random
BUSINESS_API_TIMEOUT_S=5
BUSINESS_API_MAX_RETRY=2

# --- inbound auth (MaxKB -> agent) -----------------------------------------
AGENT_INTERNAL_TOKEN=CHANGE_ME_long_random

# --- model (optional) ------------------------------------------------------
AGENT_MODE=rule_based
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=20
AGENT_TOTAL_TIMEOUT_S=30

# --- observability ---------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=shopping-backend
