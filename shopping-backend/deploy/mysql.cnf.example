# MySQL tuning that matters for this schema. Mounted into the compose mysql service.
# docs/EXTENSION_DB_DOCKER.md §3.6 explains why each line is here.

[mysqld]
# Chinese titles otherwise become '???'
character_set_server = utf8mb4
collation_server = utf8mb4_0900_ai_ci

# innodb_default_row_format=DYNAMIC keeps VARCHAR(64) indexes under the 767-byte limit
innodb_default_row_format = dynamic
innodb_file_per_table = 1

# naive UTC everywhere in the app; never let the server rewrite timestamps
log_bin_trust_function_creators = 1

# two services + healthchecks: modest pool is enough, raise with replica count
max_connections = 200
wait_timeout = 28800
interactive_timeout = 28800

[client]
default-character-set = utf8mb4
