# --- runtime ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- agent execution ---
AGENT_MODE=rule_based                # rule_based | llm  (rule_based needs no API key, no network)
AGENT_INTERNAL_TOKEN=dev-token       # MaxKB -> Agent service token; empty = skip check + WARN
AGENT_TOTAL_TIMEOUT_S=30             # whole-request budget, over -> degraded wording

# --- persistence (SQLite first, no docker / no mysql needed) ---
DATABASE_URL=sqlite:///./data/business.db
CHECKPOINT_BACKEND=sqlite            # sqlite | postgres | memory
CHECKPOINT_DB_PATH=./data/checkpoints.db
SEED_ON_STARTUP=true                 # dev only: create tables + load seeds

# --- data source driver (one switch, graph code untouched) ---
BACKEND_DRIVER=inprocess             # inprocess | http | http_java
BUSINESS_API_BASE_URL=http://127.0.0.1:8001
BUSINESS_API_TOKEN=                  # empty = business API skips auth + WARN
BUSINESS_API_TIMEOUT_S=5
BUSINESS_API_MAX_RETRY=2

# --- LLM (leave key empty to force rule_based) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_S=20
MAX_LLM_CALL_RETRIES=2

# --- guardrails / business limits ---
MAX_GOODS_LIMIT=20
MAX_FENCED_CHARS=8000
GROUNDING_PRICE_TOLERANCE_CENTS=1

# --- ports ---
AGENT_PORT=8000
BUSINESS_PORT=8001

# --- observability (LangSmith is pass-through only, no SDK required) ---
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=shopping-backend

# --- allowed origins ---
ALLOWED_ORIGINS=*
